/* =========================================================
   SURAKSHAAR - REUSABLE UI COMPONENTS
   Unity UI Toolkit USS
   Buttons, Form Fields, Cards, Chips, Badges
   ========================================================= */

/* ---------- BUTTONS ---------- */

.primary-button {
    width: 100%;
    height: 52px;
    min-height: 52px;
    background-color: rgb(0, 137, 105);
    color: rgb(255, 255, 255);
    border-radius: 12px;
    -unity-font-style: bold;
    font-size: 14px;
    -unity-text-align: middle-center;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    cursor: link;
}

.primary-button:hover {
    background-color: rgb(0, 119, 91);
}

.primary-button:active {
    background-color: rgb(0, 103, 79);
}

.secondary-button {
    width: 100%;
    height: 48px;
    min-height: 48px;
    background-color: rgb(255, 255, 255);
    color: rgb(24, 46, 64);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(226, 232, 229);
    border-radius: 12px;
    -unity-font-style: bold;
    font-size: 13px;
    -unity-text-align: middle-center;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.secondary-button:hover {
    background-color: rgb(245, 248, 246);
}

.icon-button {
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    border-radius: 20px;
    background-color: rgb(255, 255, 255);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(228, 232, 235);
    color: rgb(28, 51, 72);
    font-size: 20px;
    -unity-text-align: middle-center;
    align-items: center;
    justify-content: center;
}

.icon-button:hover {
    background-color: rgb(243, 247, 245);
}

/* ---------- CARDS ---------- */

.surface-card {
    background-color: rgb(255, 255, 255);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(228, 233, 231);
    border-radius: 12px;
    padding: 12px;
}

.tip-box {
    width: 100%;
    min-height: 52px;
    background-color: rgb(255, 250, 236);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(248, 232, 192);
    border-radius: 10px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.tip-icon {
    font-size: 20px;
    color: rgb(220, 140, 20);
    margin-right: 10px;
}

.tip-text {
    flex-grow: 1;
    font-size: 11px;
    color: rgb(85, 75, 52);
    white-space: normal;
}

/* ---------- FORM CONTROLS ---------- */

.form-field {
    width: 100%;
    margin-bottom: 14px;
}

.field-label {
    font-size: 12px;
    color: rgb(32, 53, 70);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.field-container {
    width: 100%;
    height: 48px;
    min-height: 48px;
    background-color: rgb(255, 255, 255);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(220, 228, 225);
    border-radius: 10px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
}

.field-container:focus {
    border-color: rgb(0, 137, 105);
    border-left-width: 1.5px;
    border-right-width: 1.5px;
    border-top-width: 1.5px;
    border-bottom-width: 1.5px;
}

.field-icon {
    font-size: 16px;
    color: rgb(0, 137, 105);
    margin-right: 8px;
    -unity-text-align: middle-center;
}

.field-input {
    flex-grow: 1;
    background-color: transparent;
    border-width: 0;
    font-size: 13px;
    color: rgb(24, 46, 64);
    padding: 0;
}

.unity-text-field__input {
    background-color: transparent;
    border-width: 0;
    font-size: 13px;
    color: rgb(24, 46, 64);
    padding: 0;
}

/* ---------- STATUS PILLS & BADGES ---------- */

.status-pill {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-radius: 6px;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.status-pill--success {
    background-color: rgb(226, 245, 237);
    color: rgb(11, 134, 100);
}

.status-pill--warning {
    background-color: rgb(255, 246, 225);
    color: rgb(185, 115, 15);
}

/* ---------- PROGRESS BAR ---------- */

.progress-track {
    width: 100%;
    height: 6px;
    background-color: rgb(228, 234, 231);
    border-radius: 3px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background-color: rgb(0, 150, 112);
    border-radius: 3px;
}

/* ---------- TYPOGRAPHY ---------- */

.heading-xl {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(22, 45, 64);
}

.heading-lg {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(22, 45, 64);
}

.heading-md {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(22, 45, 64);
}

.body-text {
    font-size: 11px;
    color: rgb(90, 105, 115);
    }
