/* =========================================================
   SURAKSHAAR - WORKER PROFILE STYLES
   Unity UI Toolkit USS
   Worker setup & details
   ========================================================= */

.screen--profile {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: rgb(248, 250, 249);
    padding: 18px;
    justify-content: space-between;
}

.profile-avatar-container {
    align-items: center;
    margin-top: 10px;
    margin-bottom: 20px;
}

.profile-avatar-large {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: rgb(228, 244, 238);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: rgb(0, 137, 105);
    align-items: center;
    justify-content: center;
}

.profile-avatar-large-text {
    font-size: 32px;
    color: rgb(0, 137, 105);
}

.profile-form-container {
    width: 100%;
    flex-grow: 1;
}
