# SurakshaAR backend environment configuration (DAY 4 auth / DAY 6 deployment).
#
# Copy this file to `backend/.env` and fill in real values.
# `backend/.env` is git-ignored and must NEVER be committed.
#
# Secrets are never hardcoded in the codebase; the server reads them from the
# process environment / this file via python-dotenv.

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# REQUIRED in production: the HMAC-SHA256 JWT signing key. Use a long random
# string, e.g. generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SURAKHSHAAR_SECRET_KEY=<REPLACE-with-a-long-random-token-urlsafe-48>

# Optional bootstrap admin account, created on first startup. Used by the web
# dashboard to log in (see DAY4_AUTH_HANDOFF.md). If unset, no admin is seeded.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<REPLACE-with-a-strong-password>

# Access token lifetime in minutes (default 480 = 8 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Optional override. Defaults to backend/surakhshaar.db (SQLite).
# DATABASE_URL=sqlite:///absolute/path/to/surakhshaar.db

# ---------------------------------------------------------------------------
# Server / CORS / deployment (DAY 6)
# ---------------------------------------------------------------------------

# Bind address / port used by `python run.py`.
# SURAKHSHAAR_HOST=0.0.0.0
# SURAKHSHAAR_PORT=8000

# Auto-reload is a development-only convenience. Set to 0 for the real
# deployment, or run: python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
# SURAKHSHAAR_RELOAD=1

# Comma-separated browser origins allowed to call the API. Defaults to `*`
# because the dashboard is served from the backend origin (`/dashboard`) or
# opened from the file system during an offline demo. Tighten for production:
# SURAKHSHAAR_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# When set to 1 the server REFUSES to start unless SURAKHSHAAR_SECRET_KEY and
# ADMIN_PASSWORD are configured (recommended for the real deployment; the
# default 0 only logs loud warnings at startup).
# SURAKHSHAAR_REQUIRE_SECRETS=1