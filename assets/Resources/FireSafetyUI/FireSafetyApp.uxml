<ui:UXML xmlns:ui="UnityEngine.UIElements">

    <!-- ========================================================= -->
    <!-- ROOT APPLICATION SHELL                                    -->
    <!-- ========================================================= -->

    <ui:VisualElement name="app-root" class="app-root">

        <!-- ===================================================== -->
        <!-- SPLASH / WELCOME                                      -->
        <!-- ===================================================== -->

        <ui:VisualElement name="splash-screen"
                          class="screen screen--splash">

            <ui:VisualElement class="safe-area">

                <ui:VisualElement class="splash-layout">

                    <!-- Brand -->
                    <ui:VisualElement class="splash-brand">

                        <ui:VisualElement class="brand-badge">
                            <ui:Label text="F" class="brand-badge__letter" />
                        </ui:VisualElement>

                        <ui:Label text="SAFETY FIRST"
                                   class="eyebrow eyebrow--light" />

                        <ui:Label text="Fire Safety"
                                   class="display display--light" />

                        <ui:Label text="Training"
                                   class="display display--accent" />

                        <ui:Label text="Interactive AR Safety Training"
                                   class="subtitle subtitle--light" />

                    </ui:VisualElement>


                    <!-- Hero -->
                    <ui:VisualElement class="splash-hero">

                        <ui:VisualElement class="hero-circle">

                            <ui:Label text="FIRE"
                                       class="hero-circle__title" />

                            <ui:Label text="AR"
                                       class="hero-circle__accent" />

                        </ui:VisualElement>

                        <ui:Label text="LEARN • PRACTICE • RESPOND"
                                   class="hero-caption" />

                    </ui:VisualElement>


                    <!-- Action -->
                    <ui:VisualElement class="splash-actions">

                        <ui:Button name="get-started"
                                   text="GET STARTED"
                                   class="primary-button primary-button--large primary-button--light" />

                        <ui:Label text="Professional safety training"
                                   class="caption caption--light" />

                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>


        <!-- ===================================================== -->
        <!-- LOGIN                                                  -->
        <!-- ===================================================== -->

        <ui:VisualElement name="login-screen"
                          class="screen screen--light">

            <ui:VisualElement class="safe-area">

                <ui:VisualElement class="screen-layout">

                    <!-- Header -->
                    <ui:VisualElement class="top-bar">

                        <ui:Button name="login-back"
                                   text="‹"
                                   class="icon-button" />

                        <ui:VisualElement class="top-bar__center">
                            <ui:Label text="FIRE SAFETY"
                                       class="top-bar__brand" />
                        </ui:VisualElement>

                        <ui:VisualElement class="top-bar__spacer" />

                    </ui:VisualElement>


                    <!-- Content -->
                    <ui:VisualElement class="content-column">

                        <ui:VisualElement class="screen-heading">

                            <ui:Label text="WELCOME"
                                       class="eyebrow" />

                            <ui:Label text="Ready to train safely?"
                                       class="heading" />

                            <ui:Label text="Enter your details to begin your training session."
                                       class="subtitle" />

                        </ui:VisualElement>


                        <!-- Form -->
                        <ui:VisualElement class="surface-card form-card">

                            <ui:VisualElement class="form-section">

                                <ui:TextField name="worker-name"
                                             label="WORKER NAME"
                                             class="input-field" />

                                <ui:TextField name="employee-id"
                                             label="EMPLOYEE ID"
                                             class="input-field" />

                                <ui:Label name="login-error"
                                          class="error-text" />

                            </ui:VisualElement>

                        </ui:VisualElement>


                        <ui:VisualElement class="helper-row">

                            <ui:Label text="Your information is used for this training session."
                                       class="caption" />

                        </ui:VisualElement>

                    </ui:VisualElement>


                    <!-- Bottom Actions -->
                    <ui:VisualElement class="bottom-action-bar">

                        <ui:Button name="login-continue"
                                   text="CONTINUE"
                                   class="primary-button primary-button--full" />

                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>


        <!-- ===================================================== -->
        <!-- LANGUAGE                                               -->
        <!-- ===================================================== -->

        <ui:VisualElement name="language-screen"
                          class="screen screen--light">

            <ui:VisualElement class="safe-area">

                <ui:VisualElement class="screen-layout">

                    <!-- Header -->
                    <ui:VisualElement class="top-bar">

                        <ui:Button name="language-back"
                                   text="‹"
                                   class="icon-button" />

                        <ui:VisualElement class="top-bar__center">
                            <ui:Label text="LANGUAGE"
                                       class="top-bar__brand" />
                        </ui:VisualElement>

                        <ui:VisualElement class="top-bar__spacer" />

                    </ui:VisualElement>


                    <!-- Content -->
                    <ui:VisualElement class="content-column">

                        <ui:VisualElement class="screen-heading">

                            <ui:Label text="PERSONALISE"
                                       class="eyebrow" />

                            <ui:Label text="Select your language"
                                       class="heading" />

                            <ui:Label text="Choose the language you are most comfortable with."
                                       class="subtitle" />

                        </ui:VisualElement>


                        <!-- Language List -->
                        <ui:VisualElement class="selection-list">

                            <ui:Button name="language-english"
                                       class="selection-card">

                                <ui:VisualElement class="selection-card__icon">
                                    <ui:Label text="EN"
                                               class="language-icon" />
                                </ui:VisualElement>

                                <ui:VisualElement class="selection-card__content">

                                    <ui:Label text="English"
                                               class="selection-card__title" />

                                    <ui:Label text="English"
                                               class="selection-card__subtitle" />

                                </ui:VisualElement>

                                <ui:VisualElement class="selection-card__check">
                                    <ui:Label text="✓"
                                               class="selection-indicator" />
                                </ui:VisualElement>

                            </ui:Button>


                            <ui:Button name="language-hindi"
                                       class="selection-card">

                                <ui:VisualElement class="selection-card__icon">
                                    <ui:Label text="हि"
                                               class="language-icon" />
                                </ui:VisualElement>

                                <ui:VisualElement class="selection-card__content">

                                    <ui:Label text="Hindi"
                                               class="selection-card__title" />

                                    <ui:Label text="हिन्दी"
                                               class="selection-card__subtitle" />

                                </ui:VisualElement>

                                <ui:VisualElement class="selection-card__check">
                                    <ui:Label text="✓"
                                               class="selection-indicator" />
                                </ui:VisualElement>

                            </ui:Button>


                            <ui:Button name="language-santali"
                                       class="selection-card">

                                <ui:VisualElement class="selection-card__icon">
                                    <ui:Label text="ᱥ"
                                               class="language-icon" />
                                </ui:VisualElement>

                                <ui:VisualElement class="selection-card__content">

                                    <ui:Label text="Santali"
                                               class="selection-card__title" />

                                    <ui:Label text="ᱥᱟᱱᱛᱟᱲᱤ"
                                               class="selection-card__subtitle" />

                                </ui:VisualElement>

                                <ui:VisualElement class="selection-card__check">
                                    <ui:Label text="✓"
                                               class="selection-indicator" />
                                </ui:VisualElement>

                            </ui:Button>

                        </ui:VisualElement>


                        <ui:Label name="language-selection"
                                   class="selection-text" />

                    </ui:VisualElement>


                    <!-- Bottom -->
                    <ui:VisualElement class="bottom-action-bar">

                        <ui:Button name="language-continue"
                                   text="CONTINUE"
                                   class="primary-button primary-button--full" />

                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>


        <!-- ===================================================== -->
        <!-- HOME DASHBOARD                                        -->
        <!-- ===================================================== -->

        <ui:VisualElement name="home-screen" class="screen screen--light">
            <ui:VisualElement class="safe-area">
                <ui:VisualElement class="screen-layout">
                    <ui:VisualElement class="top-bar">
                        <ui:VisualElement class="top-bar__left"><ui:Label text="SURAKSHA AR" class="top-bar__brand" /></ui:VisualElement>
                        <ui:VisualElement class="profile-avatar"><ui:Label text="W" class="profile-avatar__text" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:ScrollView class="page-scroll">
                        <ui:VisualElement class="content-column catalogue-content">
                            <ui:Label text="NAMASTE" class="eyebrow" />
                            <ui:Label text="Every worker safe, every family strong." class="heading" />
                            <ui:Label text="Continue building practical safety skills." class="subtitle" />
                            <ui:VisualElement class="training-card">
                                <ui:VisualElement class="training-card__header"><ui:Label text="YOUR PROGRESS" class="training-card__eyebrow" /><ui:Label text="0 / 5" class="status-pill status-pill--success" /></ui:VisualElement>
                                <ui:VisualElement class="progress-track"><ui:VisualElement class="progress-fill progress-fill--25" /></ui:VisualElement>
                                <ui:Label text="Complete Fire Safety training to unlock your first achievement." class="training-description" />
                            </ui:VisualElement>
                            <ui:Label text="TRAINING MODULES" class="eyebrow" />
                            <ui:Button name="home-start" class="training-card">
                                <ui:VisualElement class="training-card__header"><ui:VisualElement class="training-icon-container"><ui:Label text="F" class="training-icon" /></ui:VisualElement><ui:Label text="AVAILABLE" class="status-pill status-pill--success" /></ui:VisualElement>
                                <ui:VisualElement class="training-card__body"><ui:Label text="FIRE SAFETY" class="training-card__eyebrow" /><ui:Label text="Fire &amp; Explosion Response" class="training-title" /><ui:Label text="Learn the correct emergency response and extinguisher procedure." class="training-description" /></ui:VisualElement>
                                <ui:Label text="START TRAINING  →" class="training-cta" />
                            </ui:Button>
                            <ui:Label text="Recent activity will appear here after training." class="caption" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                    <ui:VisualElement class="bottom-action-bar"><ui:Button name="home-modules" text="VIEW ALL MODULES" class="primary-button primary-button--full" /></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ===================================================== -->
        <!-- TRAINING CATALOGUE                                    -->
        <!-- ===================================================== -->

        <ui:VisualElement name="catalogue-screen"
                          class="screen screen--light">

            <ui:VisualElement class="safe-area">

                <ui:VisualElement class="screen-layout">

                    <!-- Header -->
                    <ui:VisualElement class="top-bar">

                        <ui:VisualElement class="top-bar__left">
                            <ui:Label text="SURAKSHA AR"
                                       class="top-bar__brand" />
                        </ui:VisualElement>

                        <ui:VisualElement class="top-bar__right">
                            <ui:VisualElement class="profile-avatar">
                                <ui:Label text="W"
                                           class="profile-avatar__text" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                    </ui:VisualElement>


                    <!-- Main Content -->
                    <ui:ScrollView class="page-scroll">

                        <ui:VisualElement class="content-column catalogue-content">

                            <ui:VisualElement class="screen-heading">

                                <ui:Label text="TRAINING CATALOGUE"
                                           class="eyebrow" />

                                <ui:Label text="Choose a training module"
                                           class="heading" />

                                <ui:Label text="Select a module to begin your safety training."
                                           class="subtitle" />

                            </ui:VisualElement>


                            <!-- Search -->
                            <ui:VisualElement class="search-container">

                                <ui:Label text="⌕"
                                           class="search-icon" />

                                <ui:TextField name="training-search"
                                             label="SEARCH TRAINING"
                                             class="search-field" />

                            </ui:VisualElement>


                            <!-- Fire Training -->
                            <ui:Button name="fire-training"
                                       class="training-card">

                                <ui:VisualElement class="training-card__header">

                                    <ui:VisualElement class="training-icon-container">

                                        <ui:Label text="F"
                                                   class="training-icon" />

                                    </ui:VisualElement>

                                    <ui:Label text="AVAILABLE"
                                               class="status-pill status-pill--success" />

                                </ui:VisualElement>


                                <ui:VisualElement class="training-card__body">

                                    <ui:Label text="FIRE SAFETY"
                                               class="training-card__eyebrow" />

                                    <ui:Label text="Fire Safety"
                                               class="training-title" />

                                    <ui:Label text="Learn how to respond to a fire emergency and correctly operate a fire extinguisher."
                                               class="training-description" />

                                </ui:VisualElement>


                                <ui:VisualElement class="training-card__footer">

                                    <ui:Label text="START TRAINING"
                                               class="training-cta" />

                                    <ui:Label text="→"
                                               class="training-arrow" />

                                </ui:VisualElement>

                            </ui:Button>


                            <ui:Label name="search-empty"
                                       text="No training modules match your search."
                                       class="empty-state" />

                        </ui:VisualElement>

                    </ui:ScrollView>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>


        <!-- ===================================================== -->
        <!-- FIRE SAFETY BASICS                                   -->
        <!-- ===================================================== -->

        <ui:VisualElement name="intro-screen"
                          class="screen screen--light">

            <ui:VisualElement class="safe-area">

                <ui:VisualElement class="lesson-layout">

                    <!-- Lesson Header -->
                    <ui:VisualElement class="lesson-top">

                        <ui:VisualElement class="lesson-top__meta">

                            <ui:Label text="FIRE SAFETY"
                                       class="eyebrow" />

                            <ui:Label text="01 / 04"
                                       class="lesson-counter" />

                        </ui:VisualElement>

                        <ui:Label text="Fire Safety Basics"
                                   class="heading" />

                        <ui:Label text="Understand the fundamentals before entering the AR training."
                                   class="subtitle" />

                        <ui:VisualElement class="progress-track">

                            <ui:VisualElement class="progress-fill progress-fill--25" />

                        </ui:VisualElement>

                    </ui:VisualElement>


                    <!-- Cards -->
                    <ui:ScrollView class="lesson-scroll">

                        <ui:VisualElement class="lesson-card-list">

                            <ui:VisualElement class="info-card">

                                <ui:VisualElement class="info-card__number">
                                    <ui:Label text="01" />
                                </ui:VisualElement>

                                <ui:VisualElement class="info-card__content">

                                    <ui:Label text="STAY CALM"
                                               class="card-title" />

                                    <ui:Label text="Assess the situation and act deliberately."
                                               class="body" />

                                </ui:VisualElement>

                            </ui:VisualElement>


                            <ui:VisualElement class="info-card">

                                <ui:VisualElement class="info-card__number">
                                    <ui:Label text="02" />
                                </ui:VisualElement>

                                <ui:VisualElement class="info-card__content">

                                    <ui:Label text="RAISE THE ALARM"
                                               class="card-title" />

                                    <ui:Label text="Warn others before approaching the hazard."
                                               class="body" />

                                </ui:VisualElement>

                            </ui:VisualElement>


                            <ui:VisualElement class="info-card">

                                <ui:VisualElement class="info-card__number">
                                    <ui:Label text="03" />
                                </ui:VisualElement>

                                <ui:VisualElement class="info-card__content">

                                    <ui:Label text="USE THE CORRECT EQUIPMENT"
                                               class="card-title" />

                                    <ui:Label text="Use the extinguisher only when it is safe to do so."
                                               class="body" />

                                </ui:VisualElement>

                            </ui:VisualElement>


                            <ui:VisualElement class="info-card">

                                <ui:VisualElement class="info-card__number">
                                    <ui:Label text="04" />
                                </ui:VisualElement>

                                <ui:VisualElement class="info-card__content">

                                    <ui:Label text="KEEP A SAFE DISTANCE"
                                               class="card-title" />

                                    <ui:Label text="Aim at the base of the fire from a safe position."
                                               class="body" />

                                </ui:VisualElement>

                            </ui:VisualElement>

                        </ui:VisualElement>

                    </ui:ScrollView>


                    <!-- Bottom Navigation -->
                    <ui:VisualElement class="lesson-bottom">

                        <ui:Button name="intro-back"
                                   text="BACK"
                                   class="secondary-button" />

                        <ui:Button name="intro-next"
                                   text="NEXT"
                                   class="primary-button" />

                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>


        <!-- ===================================================== -->
        <!-- EQUIPMENT                                             -->
        <!-- ===================================================== -->

        <ui:VisualElement name="equipment-screen"
                          class="screen screen--light">

            <ui:VisualElement class="safe-area">

                <ui:VisualElement class="lesson-layout">

                    <ui:VisualElement class="lesson-top">

                        <ui:VisualElement class="lesson-top__meta">

                            <ui:Label text="FIRE SAFETY"
                                       class="eyebrow" />

                            <ui:Label text="02 / 04"
                                       class="lesson-counter" />

                        </ui:VisualElement>

                        <ui:Label text="Know Your Equipment"
                                   class="heading" />

                        <ui:Label text="Identify the parts you will use during the practical."
                                   class="subtitle" />

                        <ui:VisualElement class="progress-track">

                            <ui:VisualElement class="progress-fill progress-fill--50" />

                        </ui:VisualElement>

                    </ui:VisualElement>


                    <ui:ScrollView class="lesson-scroll">

                        <ui:VisualElement class="equipment-grid">

                            <ui:VisualElement class="equipment-card equipment-card--large">

                                <ui:VisualElement class="equipment-card__icon">
                                    <ui:Label text="F" />
                                </ui:VisualElement>

                                <ui:Label text="FIRE EXTINGUISHER"
                                           class="card-title" />

                                <ui:Label text="Controls a small fire when used correctly."
                                           class="body" />

                            </ui:VisualElement>


                            <ui:VisualElement class="equipment-card">

                                <ui:Label text="01"
                                           class="equipment-number" />

                                <ui:Label text="SAFETY PIN"
                                           class="card-title" />

                                <ui:Label text="Prevents accidental discharge. Remove it before operation."
                                           class="body" />

                            </ui:VisualElement>


                            <ui:VisualElement class="equipment-card">

                                <ui:Label text="02"
                                           class="equipment-number" />

                                <ui:Label text="HOSE"
                                           class="card-title" />

                                <ui:Label text="Direct the extinguishing agent toward the base of the fire."
                                           class="body" />

                            </ui:VisualElement>


                            <ui:VisualElement class="equipment-card">

                                <ui:Label text="03"
                                           class="equipment-number" />

                                <ui:Label text="HANDLE"
                                           class="card-title" />

                                <ui:Label text="Squeeze the handle to discharge the extinguishing agent."
                                           class="body" />

                            </ui:VisualElement>


                            <ui:VisualElement class="equipment-card">

                                <ui:Label text="04"
                                           class="equipment-number" />

                                <ui:Label text="SPRAY POINT"
                                           class="card-title" />

                                <ui:Label text="The end of the hose where the extinguishing agent is directed."
                                           class="body" />

                            </ui:VisualElement>

                        </ui:VisualElement>

                    </ui:ScrollView>


                    <ui:VisualElement class="lesson-bottom">

                        <ui:Button name="equipment-back"
                                   text="BACK"
                                   class="secondary-button" />

                        <ui:Button name="equipment-next"
                                   text="NEXT"
                                   class="primary-button" />

                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>


        <!-- ===================================================== -->
        <!-- HOW TO USE                                             -->
        <!-- ===================================================== -->

        <ui:VisualElement name="howto-screen"
                          class="screen screen--light">

            <ui:VisualElement class="safe-area">

                <ui:VisualElement class="lesson-layout">

                    <ui:VisualElement class="lesson-top">

                        <ui:VisualElement class="lesson-top__meta">

                            <ui:Label text="FIRE SAFETY"
                                       class="eyebrow" />

                            <ui:Label text="03 / 04"
                                       class="lesson-counter" />

                        </ui:VisualElement>

                        <ui:Label text="How to use the extinguisher"
                                   class="heading" />

                        <ui:Label text="Follow these steps during the practical exercise."
                                   class="subtitle" />

                        <ui:VisualElement class="progress-track">

                            <ui:VisualElement class="progress-fill progress-fill--75" />

                        </ui:VisualElement>

                    </ui:VisualElement>


                    <!-- Steps -->
                    <ui:ScrollView class="lesson-scroll">

                        <ui:VisualElement class="step-list">

                            <ui:VisualElement class="step-card step-card--active">

                                <ui:VisualElement class="step-card__number">
                                    <ui:Label text="01" />
                                </ui:VisualElement>

                                <ui:VisualElement class="step-card__content">

                                    <ui:Label text="RAISE THE ALARM"
                                               class="step-title" />

                                    <ui:Label text="Alert people nearby before approaching the fire."
                                               class="step-description" />

                                </ui:VisualElement>

                                <ui:Label text="✓"
                                           class="step-check" />

                            </ui:VisualElement>


                            <ui:VisualElement class="step-card">

                                <ui:VisualElement class="step-card__number">
                                    <ui:Label text="02" />
                                </ui:VisualElement>

                                <ui:VisualElement class="step-card__content">

                                    <ui:Label text="PICK UP THE EXTINGUISHER"
                                               class="step-title" />

                                    <ui:Label text="Take hold of the extinguisher when instructed."
                                               class="step-description" />

                                </ui:VisualElement>

                            </ui:VisualElement>


                            <ui:VisualElement class="step-card">

                                <ui:VisualElement class="step-card__number">
                                    <ui:Label text="03" />
                                </ui:VisualElement>

                                <ui:VisualElement class="step-card__content">

                                    <ui:Label text="REMOVE THE SAFETY PIN"
                                               class="step-title" />

                                    <ui:Label text="Remove the pin before operating the extinguisher."
                                               class="step-description" />

                                </ui:VisualElement>

                            </ui:VisualElement>


                            <ui:VisualElement class="step-card">

                                <ui:VisualElement class="step-card__number">
                                    <ui:Label text="04" />
                                </ui:VisualElement>

                                <ui:VisualElement class="step-card__content">

                                    <ui:Label text="AIM THE HOSE"
                                               class="step-title" />

                                    <ui:Label text="Direct the spray point toward the base of the fire."
                                               class="step-description" />

                                </ui:VisualElement>

                            </ui:VisualElement>


                            <ui:VisualElement class="step-card">

                                <ui:VisualElement class="step-card__number">
                                    <ui:Label text="05" />
                                </ui:VisualElement>

                                <ui:VisualElement class="step-card__content">

                                    <ui:Label text="SQUEEZE AND SWEEP"
                                               class="step-title" />

                                    <ui:Label text="Sweep the spray across the base until the fire is extinguished."
                                               class="step-description" />

                                </ui:VisualElement>

                            </ui:VisualElement>

                        </ui:VisualElement>

                    </ui:ScrollView>


                    <!-- Bottom -->
                    <ui:VisualElement class="lesson-bottom">

                        <ui:Button name="howto-back"
                                   text="BACK"
                                   class="secondary-button" />

                        <ui:Button name="start-ar"
                                   text="START AR TRAINING"
                                   class="primary-button primary-button--large" />

                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
