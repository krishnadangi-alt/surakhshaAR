/* ============================================================
   FIRE SAFETY AR TRAINING
   PROFESSIONAL MOBILE UI
   Unity UI Toolkit USS
   ============================================================ */


/* ============================================================
   1. DESIGN TOKENS
   ============================================================ */

:root {

    --color-primary: #B3261E;
    --color-primary-dark: #7F1D1D;
    --color-primary-soft: #FBEDEC;

    --color-ink: #17212B;
    --color-ink-soft: #34424D;

    --color-background: #F5F6F7;
    --color-surface: #FFFFFF;

    --color-muted: #65717C;
    --color-muted-light: #8A949C;

    --color-border: #E1E5E8;
    --color-border-dark: #CDD3D8;

    --color-success: #18794E;
    --color-success-soft: #E8F5EE;

    --color-white: #FFFFFF;

    --spacing-xs: 4px;
    --spacing-sm: 8px;
    --spacing-md: 12px;
    --spacing-lg: 16px;
    --spacing-xl: 20px;
    --spacing-xxl: 24px;
}


/* ============================================================
   2. APPLICATION ROOT
   ============================================================ */

.app-root {

    flex-grow: 1;

    width: 100%;
    height: 100%;

    background-color: var(--color-background);

    color: var(--color-ink);

    overflow: hidden;
}


/* ============================================================
   3. SCREENS
   ============================================================ */

.screen {

    display: none;

    flex-grow: 1;

    width: 100%;
    height: 100%;

    align-items: stretch;
    justify-content: flex-start;

    overflow: hidden;
}


.screen--light {

    background-color: var(--color-background);
}


.screen--splash {

    background-color: var(--color-ink);
}


/* ============================================================
   4. SAFE AREA
   ============================================================ */

.safe-area {

    width: 100%;
    height: 100%;

    flex-grow: 1;

    padding-left: 20px;
    padding-right: 20px;

    padding-top: 28px;
    padding-bottom: 20px;

    align-items: stretch;
}


/* ============================================================
   5. GENERAL SCREEN LAYOUT
   ============================================================ */

.screen-layout {

    width: 100%;
    height: 100%;

    flex-grow: 1;

    align-items: stretch;
    justify-content: space-between;
}


/* ============================================================
   6. TOP BAR
   ============================================================ */

.top-bar {

    width: 100%;

    min-height: 52px;

    flex-direction: row;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 18px;
}


.top-bar__left {

    flex-direction: row;

    align-items: center;
}


.top-bar__center {

    flex-grow: 1;

    align-items: center;
    justify-content: center;
}


.top-bar__right {

    flex-direction: row;

    align-items: center;
}


.top-bar__spacer {

    width: 42px;
}


.top-bar__brand {

    color: var(--color-ink);

    font-size: 13px;

    -unity-font-style: bold;

    letter-spacing: 1.2px;
}


/* ============================================================
   7. ICON BUTTON
   ============================================================ */

.icon-button {

    width: 42px;
    height: 42px;

    min-width: 42px;
    min-height: 42px;

    padding: 0;

    border-radius: 21px;

    background-color: var(--color-surface);

    border-color: var(--color-border);

    color: var(--color-ink);

    font-size: 28px;

    -unity-text-align: middle-center;
}


.icon-button:hover {

    background-color: var(--color-primary-soft);

    border-color: var(--color-primary);

    color: var(--color-primary);
}


/* ============================================================
   8. PROFILE AVATAR
   ============================================================ */

.profile-avatar {

    width: 40px;
    height: 40px;

    min-width: 40px;
    min-height: 40px;

    border-radius: 20px;

    background-color: var(--color-primary);

    align-items: center;
    justify-content: center;
}


.profile-avatar__text {

    color: var(--color-white);

    font-size: 15px;

    -unity-font-style: bold;
}


/* ============================================================
   9. CONTENT COLUMN
   ============================================================ */

.content-column {

    width: 100%;

    flex-grow: 1;

    align-items: stretch;

    justify-content: flex-start;
}


.screen-heading {

    width: 100%;

    margin-bottom: 22px;
}


/* ============================================================
   10. TYPOGRAPHY
   ============================================================ */

.eyebrow {

    color: var(--color-primary);

    font-size: 11px;

    -unity-font-style: bold;

    letter-spacing: 1.5px;

    margin-bottom: 7px;
}


.heading {

    color: var(--color-ink);

    font-size: 27px;

    -unity-font-style: bold;

    line-height: 34px;

    white-space: normal;

    margin-bottom: 8px;
}


.subtitle {

    color: var(--color-muted);

    font-size: 15px;

    line-height: 22px;

    white-space: normal;
}


.caption {

    color: var(--color-muted-light);

    font-size: 11px;

    line-height: 16px;

    white-space: normal;
}


/* ============================================================
   11. SPLASH SCREEN
   ============================================================ */

.splash-layout {

    width: 100%;
    height: 100%;

    flex-grow: 1;

    align-items: stretch;

    justify-content: space-between;
}


.splash-brand {

    margin-top: 25px;

    align-items: flex-start;
}


.brand-badge {

    width: 46px;
    height: 46px;

    border-radius: 23px;

    background-color: var(--color-primary);

    align-items: center;
    justify-content: center;

    margin-bottom: 22px;
}


.brand-badge__letter {

    color: var(--color-white);

    font-size: 22px;

    -unity-font-style: bold;
}


.eyebrow--light {

    color: #FFB4AC;
}


.display {

    color: var(--color-white);

    font-size: 39px;

    -unity-font-style: bold;

    line-height: 43px;

    white-space: normal;
}


.display--light {

    color: var(--color-white);
}


.display--accent {

    color: #FFB4AC;
}


.subtitle--light {

    color: #D5DCE3;
}


/* ============================================================
   12. SPLASH HERO
   ============================================================ */

.splash-hero {

    flex-grow: 1;

    align-items: center;

    justify-content: center;
}


.hero-circle {

    width: 175px;
    height: 175px;

    border-radius: 88px;

    border-width: 1px;
    border-color: #52606B;

    align-items: center;
    justify-content: center;
}


.hero-circle__title {

    color: var(--color-white);

    font-size: 34px;

    -unity-font-style: bold;

    letter-spacing: 3px;
}


.hero-circle__accent {

    color: #FFB4AC;

    font-size: 34px;

    -unity-font-style: bold;

    margin-top: -3px;
}


.hero-caption {

    color: #AEB8C0;

    font-size: 10px;

    -unity-font-style: bold;

    letter-spacing: 1.5px;

    margin-top: 20px;
}


.splash-actions {

    width: 100%;

    align-items: stretch;

    margin-bottom: 8px;
}


/* ============================================================
   13. BUTTONS
   ============================================================ */

.primary-button {

    min-height: 52px;

    height: 52px;

    border-radius: 13px;

    background-color: var(--color-primary);

    border-color: var(--color-primary);

    color: var(--color-white);

    font-size: 14px;

    -unity-font-style: bold;

    -unity-text-align: middle-center;

    margin-top: 0;
}


.primary-button:hover {

    background-color: var(--color-primary-dark);

    border-color: var(--color-primary-dark);
}


.primary-button:active {

    background-color: #641515;
}


.primary-button--large {

    min-height: 56px;

    height: 56px;

    font-size: 15px;
}


.primary-button--full {

    width: 100%;
}


.primary-button--light {

    background-color: var(--color-white);

    border-color: var(--color-white);

    color: var(--color-primary-dark);
}


.primary-button--light:hover {

    background-color: #F5F5F5;

    border-color: #F5F5F5;
}


.secondary-button {

    min-height: 52px;

    height: 52px;

    border-radius: 13px;

    background-color: var(--color-surface);

    border-color: var(--color-border-dark);

    color: var(--color-ink);

    font-size: 14px;

    -unity-font-style: bold;

    -unity-text-align: middle-center;
}


.secondary-button:hover {

    background-color: var(--color-primary-soft);

    border-color: var(--color-primary);

    color: var(--color-primary);
}


/* ============================================================
   14. BOTTOM ACTION BAR
   ============================================================ */

.bottom-action-bar {

    width: 100%;

    align-items: stretch;

    justify-content: flex-end;

    margin-top: 16px;
}


/* ============================================================
   15. FORM
   ============================================================ */

.form-card {

    width: 100%;

    background-color: var(--color-surface);

    border-radius: 18px;

    border-width: 1px;

    border-color: var(--color-border);

    padding: 20px 18px 14px;
}


.form-section {

    width: 100%;

    align-items: stretch;
}


.input-field {

    width: 100%;

    margin-bottom: 16px;
}


.input-field > .unity-base-field__label {

    color: var(--color-muted);

    font-size: 11px;

    -unity-font-style: bold;

    letter-spacing: 0.8px;

    margin-bottom: 7px;
}


.input-field > .unity-base-text-field__input {

    min-height: 50px;

    height: 50px;

    background-color: var(--color-background);

    color: var(--color-ink);

    border-width: 1px;

    border-color: var(--color-border);

    border-radius: 11px;

    padding-left: 14px;

    padding-right: 14px;

    font-size: 15px;
}


.input-field > .unity-base-text-field__input:focus {

    border-color: var(--color-primary);

    background-color: var(--color-white);
}


.error-text {

    min-height: 20px;

    color: var(--color-primary);

    font-size: 12px;

    margin-top: 2px;
}


.helper-row {

    width: 100%;

    margin-top: 12px;
}


/* ============================================================
   16. LANGUAGE SELECTION
   ============================================================ */

.selection-list {

    width: 100%;

    align-items: stretch;
}


.selection-card {

    width: 100%;

    min-height: 78px;

    height: 78px;

    padding: 11px 14px;

    margin-bottom: 11px;

    flex-direction: row;

    align-items: center;

    background-color: var(--color-surface);

    border-width: 1px;

    border-color: var(--color-border);

    border-radius: 15px;
}


.selection-card:hover {

    border-color: var(--color-primary);

    background-color: #FFF9F8;
}


.selection-card__icon {

    width: 46px;
    height: 46px;

    min-width: 46px;

    border-radius: 23px;

    background-color: #F1F3F4;

    align-items: center;

    justify-content: center;
}


.language-icon {

    color: var(--color-primary);

    font-size: 16px;

    -unity-font-style: bold;

    -unity-text-align: middle-center;
}


.selection-card__content {

    flex-grow: 1;

    margin-left: 14px;

    align-items: flex-start;
}


.selection-card__title {

    color: var(--color-ink);

    font-size: 16px;

    -unity-font-style: bold;
}


.selection-card__subtitle {

    color: var(--color-muted);

    font-size: 12px;

    margin-top: 3px;
}


.selection-card__check {

    width: 28px;
    height: 28px;

    min-width: 28px;

    border-radius: 14px;

    align-items: center;
    justify-content: center;
}


.selection-indicator {

    display: none;

    color: var(--color-success);

    font-size: 19px;

    -unity-font-style: bold;

    -unity-text-align: middle-center;
}


.selection-card--selected {

    background-color: var(--color-primary-soft);

    border-color: var(--color-primary);
}


.selection-card--selected .selection-card__icon {

    background-color: var(--color-primary);
}


.selection-card--selected .language-icon {

    color: var(--color-white);
}


.selection-card--selected .selection-indicator {

    display: flex;
}


.selection-text {

    min-height: 20px;

    color: var(--color-success);

    font-size: 12px;

    -unity-font-style: bold;

    margin-top: 2px;
}


/* ============================================================
   17. CATALOGUE
   ============================================================ */

.page-scroll {

    flex-grow: 1;

    width: 100%;
}


.catalogue-content {

    padding-bottom: 20px;
}


.search-container {

    width: 100%;

    min-height: 52px;

    flex-direction: row;

    align-items: center;

    background-color: var(--color-surface);

    border-width: 1px;

    border-color: var(--color-border);

    border-radius: 13px;

    margin-bottom: 18px;
}


.search-icon {

    width: 42px;

    color: var(--color-muted);

    font-size: 22px;

    -unity-text-align: middle-center;
}


.search-field {

    flex-grow: 1;

    margin-bottom: 0;
}


.search-field > .unity-base-field__label {

    display: none;
}


.search-field > .unity-base-text-field__input {

    background-color: transparent;

    border-width: 0;

    color: var(--color-ink);

    min-height: 50px;

    padding-left: 0;

    font-size: 14px;
}


/* ============================================================
   18. TRAINING CARD
   ============================================================ */

.training-card {

    width: 100%;

    min-height: 275px;

    padding: 20px;

    align-items: stretch;

    background-color: var(--color-surface);

    border-width: 1px;

    border-color: var(--color-border);

    border-radius: 19px;
}


.training-card:hover {

    background-color: #FFF9F8;

    border-color: var(--color-primary);
}


.training-card__header {

    width: 100%;

    flex-direction: row;

    justify-content: space-between;

    align-items: center;
}


.training-icon-container {

    width: 50px;
    height: 50px;

    min-width: 50px;

    border-radius: 14px;

    background-color: var(--color-primary-soft);

    align-items: center;

    justify-content: center;
}


.training-icon {

    color: var(--color-primary);

    font-size: 17px;

    -unity-font-style: bold;

    -unity-text-align: middle-center;
}


.status-pill {

    padding: 6px 10px;

    border-radius: 9px;

    font-size: 10px;

    -unity-font-style: bold;
}


.status-pill--success {

    background-color: var(--color-success-soft);

    color: var(--color-success);
}


.training-card__body {

    flex-grow: 1;

    justify-content: center;

    align-items: flex-start;
}


.training-card__eyebrow {

    color: var(--color-primary);

    font-size: 10px;

    -unity-font-style: bold;

    letter-spacing: 1.2px;

    margin-bottom: 6px;
}


.training-title {

    color: var(--color-ink);

    font-size: 24px;

    -unity-font-style: bold;

    margin-bottom: 8px;
}


.training-description {

    color: var(--color-muted);

    font-size: 14px;

    line-height: 21px;

    white-space: normal;
}


.training-card__footer {

    width: 100%;

    flex-direction: row;

    align-items: center;

    justify-content: space-between;

    margin-top: 16px;
}


.training-cta {

    color: var(--color-primary);

    font-size: 11px;

    -unity-font-style: bold;

    letter-spacing: 0.7px;
}


.training-arrow {

    color: var(--color-primary);

    font-size: 20px;

    -unity-font-style: bold;
}


.empty-state {

    display: none;

    color: var(--color-muted);

    font-size: 13px;

    -unity-text-align: middle-center;

    margin-top: 30px;
}


/* ============================================================
   19. LESSON LAYOUT
   ============================================================ */

.lesson-layout {

    width: 100%;
    height: 100%;

    flex-grow: 1;

    align-items: stretch;

    justify-content: space-between;
}


.lesson-top {

    width: 100%;

    margin-bottom: 14px;
}


.lesson-top__meta {

    width: 100%;

    flex-direction: row;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 6px;
}


.lesson-counter {

    color: var(--color-muted);

    font-size: 11px;

    -unity-font-style: bold;
}


.progress-track {

    width: 100%;

    height: 5px;

    background-color: #E0E4E7;

    border-radius: 3px;

    margin-top: 13px;

    overflow: hidden;
}


.progress-fill {

    height: 5px;

    background-color: var(--color-primary);

    border-radius: 3px;
}


.progress-fill--25 {

    width: 25%;
}


.progress-fill--50 {

    width: 50%;
}


.progress-fill--75 {

    width: 75%;
}


/* ============================================================
   20. LESSON SCROLL
   ============================================================ */

.lesson-scroll {

    flex-grow: 1;

    width: 100%;

    margin-bottom: 12px;
}


.lesson-card-list {

    width: 100%;

    padding-bottom: 8px;
}


/* ============================================================
   21. INFORMATION CARDS
   ============================================================ */

.info-card {

    width: 100%;

    min-height: 92px;

    flex-direction: row;

    align-items: center;

    background-color: var(--color-surface);

    border-width: 1px;

    border-color: var(--color-border);

    border-radius: 15px;

    padding: 15px;

    margin-bottom: 10px;
}


.info-card__number {

    width: 42px;
    height: 42px;

    min-width: 42px;

    border-radius: 21px;

    background-color: var(--color-primary-soft);

    align-items: center;

    justify-content: center;

    margin-right: 13px;
}


.info-card__number > Label {

    color: var(--color-primary);

    font-size: 12px;

    -unity-font-style: bold;

    -unity-text-align: middle-center;
}


.info-card__content {

    flex-grow: 1;

    align-items: flex-start;
}


.card-title {

    color: var(--color-ink);

    font-size: 14px;

    -unity-font-style: bold;

    white-space: normal;

    margin-bottom: 5px;
}


.body {

    color: var(--color-muted);

    font-size: 13px;

    line-height: 19px;

    white-space: normal;
}


/* ============================================================
   22. LESSON BOTTOM
   ============================================================ */

.lesson-bottom {

    width: 100%;

    flex-direction: row;

    align-items: stretch;

    justify-content: space-between;

    margin-top: 8px;
}


.lesson-bottom .secondary-button {

    width: 34%;

    margin-right: 6px;
}


.lesson-bottom .primary-button {

    flex-grow: 1;

    margin-left: 6px;
}


/* ============================================================
   23. EQUIPMENT
   ============================================================ */

.equipment-grid {

    width: 100%;

    padding-bottom: 10px;
}


.equipment-card {

    width: 100%;

    min-height: 110px;

    background-color: var(--color-surface);

    border-width: 1px;

    border-color: var(--color-border);

    border-radius: 15px;

    padding: 16px;

    margin-bottom: 10px;

    align-items: flex-start;
}


.equipment-card--large {

    min-height: 135px;

    background-color: var(--color-primary-soft);

    border-color: #E6BDB9;
}


.equipment-card__icon {

    width: 42px;
    height: 42px;

    border-radius: 12px;

    background-color: var(--color-primary);

    align-items: center;

    justify-content: center;

    margin-bottom: 12px;
}


.equipment-card__icon > Label {

    color: var(--color-white);

    font-size: 17px;

    -unity-font-style: bold;
}


.equipment-number {

    color: var(--color-primary);

    font-size: 11px;

    -unity-font-style: bold;

    margin-bottom: 6px;
}


/* ============================================================
   24. HOW-TO STEPS
   ============================================================ */

.step-list {

    width: 100%;

    padding-bottom: 10px;
}


.step-card {

    width: 100%;

    min-height: 76px;

    flex-direction: row;

    align-items: center;

    background-color: var(--color-surface);

    border-width: 1px;

    border-color: var(--color-border);

    border-radius: 15px;

    padding: 11px 13px;

    margin-bottom: 9px;
}


.step-card--active {

    background-color: var(--color-primary-soft);

    border-color: var(--color-primary);
}


.step-card__number {

    width: 44px;
    height: 44px;

    min-width: 44px;

    border-radius: 22px;

    background-color: #F0F2F3;

    align-items: center;

    justify-content: center;

    margin-right: 13px;
}


.step-card--active .step-card__number {

    background-color: var(--color-primary);
}


.step-card__number > Label {

    color: var(--color-ink-soft);

    font-size: 12px;

    -unity-font-style: bold;

    -unity-text-align: middle-center;
}


.step-card--active .step-card__number > Label {

    color: var(--color-white);
}


.step-card__content {

    flex-grow: 1;

    align-items: flex-start;

    justify-content: center;
}


.step-title {

    color: var(--color-ink);

    font-size: 14px;

    -unity-font-style: bold;

    white-space: normal;

    margin-bottom: 4px;
}


.step-description {

    color: var(--color-muted);

    font-size: 12px;

    line-height: 17px;

    white-space: normal;
}


.step-check {

    display: none;

    width: 24px;

    color: var(--color-success);

    font-size: 17px;

    -unity-font-style: bold;
}


/* ============================================================
   25. AR OVERLAY
   ============================================================ */

.ar-root {

    flex-grow: 1;

    width: 100%;
    height: 100%;

    justify-content: flex-end;

    padding: 20px 16px 24px;
}


.ar-top {

    position: absolute;

    top: 22px;
    left: 16px;

    background-color: rgba(23, 33, 43, 0.92);

    border-radius: 14px;

    padding: 9px 13px;
}


.ar-step-text {

    color: var(--color-white);

    font-size: 11px;

    -unity-font-style: bold;

    letter-spacing: 1px;
}


.ar-progress {

    position: absolute;

    top: 68px;

    left: 16px;
    right: 16px;

    height: 30px;

    background-color: rgba(23, 33, 43, 0.9);

    border-radius: 15px;

    overflow: hidden;

    justify-content: center;
}


.ar-progress-fill {

    position: absolute;

    left: 0;
    top: 0;
    bottom: 0;

    background-color: var(--color-success);
}


.ar-progress-text {

    color: var(--color-white);

    font-size: 11px;

    -unity-font-style: bold;

    align-self: center;

    z-index: 1;
}


.ar-hint {

    width: 100%;

    background-color: rgba(23, 33, 43, 0.94);

    border-radius: 15px;

    padding: 15px;

    margin-top: 9px;
}


.ar-hint-text {

    color: var(--color-white);

    font-size: 14px;

    line-height: 20px;

    text-align: center;

    white-space: normal;
}


.ar-action {

    width: 100%;

    margin: 0 0 9px;
}


.ar-action .primary-button {

    width: 100%;
}


.ar-card {

    position: absolute;

    left: 20px;
    right: 20px;

    top: 24%;

    background-color: rgba(255,255,255,0.98);

    border-radius: 18px;

    padding: 23px 19px;
}


.ar-card-title {

    color: var(--color-primary);

    font-size: 20px;

    -unity-font-style: bold;

    text-align: center;

    margin-bottom: 9px;
}


.ar-card-body {

    color: var(--color-ink);

    font-size: 14px;

    line-height: 21px;

    white-space: normal;

    text-align: center;
}


.ar-card-footer {

    color: var(--color-muted);

    font-size: 11px;

    -unity-font-style: bold;

    text-align: center;

    margin-top: 17px;
}


.ar-completion {

    top: 14%;
}


.success-state {

    color: var(--color-success);
}


/* ============================================================
   26. MOBILE RESPONSIVE
   ============================================================ */

@media (max-width: 480px) {

    .safe-area {

        padding-left: 16px;
        padding-right: 16px;

        padding-top: 22px;
        padding-bottom: 16px;
    }


    .heading {

        font-size: 24px;

        line-height: 30px;
    }


    .display {

        font-size: 34px;

        line-height: 38px;
    }


    .hero-circle {

        width: 150px;
        height: 150px;

        border-radius: 75px;
    }


    .hero-circle__title,
    .hero-circle__accent {

        font-size: 29px;
    }


    .training-card {

        min-height: 250px;

        padding: 18px;
    }


    .training-title {

        font-size: 22px;
    }


    .info-card {

        min-height: 86px;

        padding: 13px;
    }


    .step-card {

        min-height: 72px;

        padding: 10px;
    }


    .step-card__number {

        width: 40px;
        height: 40px;

        min-width: 40px;

        border-radius: 20px;

        margin-right: 10px;
    }


    .step-title {

        font-size: 13px;
    }


    .step-description {

        font-size: 11px;

        line-height: 16px;
    }
}


/* ============================================================
   27. VERY SMALL DEVICES
   ============================================================ */

@media (max-width: 360px) {

    .safe-area {

        padding-left: 13px;
        padding-right: 13px;

        padding-top: 18px;
        padding-bottom: 13px;
    }


    .heading {

        font-size: 22px;

        line-height: 27px;
    }


    .subtitle {

        font-size: 13px;

        line-height: 19px;
    }


    .primary-button,
    .secondary-button {

        min-height: 48px;

        height: 48px;

        font-size: 12px;
    }


    .selection-card {

        min-height: 70px;

        height: 70px;
    }


    .selection-card__icon {

        width: 40px;
        height: 40px;

        min-width: 40px;

        border-radius: 20px;
    }


    .training-card {

        min-height: 235px;
    }
}